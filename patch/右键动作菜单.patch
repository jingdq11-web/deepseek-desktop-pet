+using System;
+using System.Windows;
+using System.Windows.Controls;
+
+namespace BigBlueFish.Windows;
+
+// 右键菜单里的「鱼鱼的日常」：喂食、番茄钟、看她汇报你在干什么、剪贴板开关。
+public partial class MainWindow
+{
+    private void AppendDailyMenu(ContextMenu menu)
+    {
+        var itemStyle = menu.TryFindResource(typeof(MenuItem)) as Style;
+        MenuItem NewItem(string header)
+        {
+            var item = new MenuItem { Header = header };
+            if (itemStyle != null) item.Style = itemStyle;
+            return item;
+        }
+
+        var root = NewItem("鱼鱼的日常");
+        root.Icon = MenuGlyph("\uE787");
+
+        var feed = NewItem("喂她吃点东西");
+        feed.Click += (_, _) => { menu.IsOpen = false; FeedCompanion(); };
+        root.Items.Add(feed);
+
+        var pomodoro = NewItem("番茄钟");
+        var start25 = NewItem("开始 25 分钟");
+        start25.Click += (_, _) => { menu.IsOpen = false; StartPomodoro(25); };
+        var start45 = NewItem("开始 45 分钟");
+        start45.Click += (_, _) => { menu.IsOpen = false; StartPomodoro(45); };
+        var stop = NewItem("停止计时");
+        stop.Click += (_, _) => { menu.IsOpen = false; StopPomodoro(); };
+        pomodoro.Items.Add(start25);
+        pomodoro.Items.Add(start45);
+        pomodoro.Items.Add(new Separator());
+        pomodoro.Items.Add(stop);
+        root.Items.Add(pomodoro);
+
+        // 看画面 + 说出她在干什么、她自己怎么想。不往剪贴板写东西。
+        var report = NewItem("看看主人在干什么");
+        report.Click += (_, _) => { menu.IsOpen = false; _ = ReportScreenAsync(); };
+        root.Items.Add(report);
+
+        var clipboard = NewItem("剪贴板联动");
+        clipboard.Click += (_, _) =>
+        {
+            menu.IsOpen = false;
+            preferences.ClipboardWatch = !preferences.ClipboardWatch;
+            clipboardLast = "";
+            SaveCompanion();
+            ShowCompanionNotice(preferences.ClipboardWatch
+                ? "好！主人复制东西的时候鱼鱼会偷偷看一眼～"
+                : "那鱼鱼不看剪贴板了。");
+        };
+        root.Items.Add(clipboard);
+
+        root.Items.Add(new Separator());
+        var status = NewItem("状态");
+        status.IsEnabled = false;
+        root.Items.Add(status);
+
+        // 动态文字在展开时刷新，避免菜单长期挂着旧数值。
+        root.SubmenuOpened += (_, _) =>
+        {
+            feed.IsEnabled = !PuppetActive;
+            report.IsEnabled = !PuppetActive;
+            clipboard.Header = preferences.ClipboardWatch ? "剪贴板联动：开" : "剪贴板联动：关";
+            pomodoro.Header = PomodoroRunning ? PomodoroLabel() : "番茄钟";
+            stop.IsEnabled = PomodoroRunning;
+            status.Header = VitalsSummary();
+        };
+
+        menu.Items.Add(new Separator());
+        menu.Items.Add(root);
+    }
+}
