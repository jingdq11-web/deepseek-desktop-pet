+
+namespace BigBlueFish.Windows;
+
+// 右上角的三格小仪表：好感 / 饱食 / 精力。
+//
+// 设计参考（VPet、Tongluv 这类养成桌宠的通行做法）：
+// 数值必须「一眼看得懂」，所以用图标 + 短条，不用数字；低于阈值才动起来吸引注意，
+// 平时安静待着，不抢戏。点一下能看到具体数值和她的心情。
+public partial class MainWindow
+{
+    private sealed class VitalsGauge
+    {
+        public required FrameworkElement Row { get; init; }
+        public required Rectangle Fill { get; init; }
+        public required FrameworkElement Icon { get; init; }
+        public required ScaleTransform Scale { get; init; }
+        public double Shown { get; set; }
+        public double Target { get; set; }
+        public DateTime FlashUntil { get; set; }
+        public double TrackWidth { get; init; }
+    }
+
+    private readonly VitalsGauge[] gauges = new VitalsGauge[3];
+    private FrameworkElement? vitalsHud;
+
+    // 气泡给右上角仪表让出的宽度（DIP）。
+    internal double CompanionBubbleRightInset => vitalsHud != null ? 44 : 0;
+    private DateTime vitalsHudBuilt = DateTime.MinValue;
+
+    private static readonly Color HeartColor = Color.FromRgb(0xE2, 0x5C, 0x7C);
+    private static readonly Color RiceColor = Color.FromRgb(0xE0, 0x9B, 0x3D);
+    private static readonly Color BoltColor = Color.FromRgb(0x4F, 0x9E, 0xC8);
+
+    private void BuildVitalsHud()
+    {
+        var panel = new StackPanel
+        {
+            Orientation = Orientation.Vertical,
+            HorizontalAlignment = HorizontalAlignment.Right,
+            VerticalAlignment = VerticalAlignment.Top,
+            Margin = new Thickness(0, 6, 8, 0),
+            IsHitTestVisible = true,
+            Cursor = Cursors.Hand,
+            ToolTip = "点一下，鱼鱼会说说自己的状态"
+        };
+
+        gauges[0] = AddGauge(panel, GlyphIcon("\u2665", HeartColor), HeartColor);
+        gauges[1] = AddGauge(panel, BowlIcon(RiceColor), RiceColor);
+        gauges[2] = AddGauge(panel, GlyphIcon("\u26A1", BoltColor), BoltColor);
+
+        // 点仪表不拖窗，改让她说一句自己的状态。
+        panel.PreviewMouseLeftButtonDown += (_, e) =>
+        {
+            e.Handled = true;
+            ShowCompanionNotice(VitalsSummary(), 12);
+        };
+        panel.PreviewMouseRightButtonDown += (_, e) => e.Handled = true;
+
+        Panel.SetZIndex(panel, 25);
+        vitalsHud = panel;
+        companionLayout.Children.Add(panel);
+        vitalsHudBuilt = DateTime.UtcNow;
+    }
+
+    private static FrameworkElement GlyphIcon(string glyph, Color color) => new TextBlock
+    {
+        Text = glyph,
+        FontSize = 11,
+        Width = 12,
+        TextAlignment = TextAlignment.Center,
+        VerticalAlignment = VerticalAlignment.Center,
+        Foreground = new SolidColorBrush(color),
+        FontFamily = new FontFamily("Segoe UI Symbol")
+    };
+
+    // 一只小饭碗：碗身 + 上面一撮饭。比一个圆点更像"饱食"。
+    private static FrameworkElement BowlIcon(Color color)
+    {
+        var brush = new SolidColorBrush(color);
+        var canvas = new Canvas { Width = 12, Height = 12, VerticalAlignment = VerticalAlignment.Center };
+        var bowl = new Path
+        {
+            Data = Geometry.Parse("M1.4,5.2 L10.6,5.2 C10.6,8.4 8.8,10.4 6,10.4 C3.2,10.4 1.4,8.4 1.4,5.2 Z"),
+            Fill = brush
+        };
+        var rice = new Path
+        {
+            Data = Geometry.Parse("M2.6,4.6 C3.4,3.1 4.5,2.3 6,2.3 C7.5,2.3 8.6,3.1 9.4,4.6 Z"),
+            Fill = brush,
+            Opacity = .75
+        };
+        var baseLine = new Path
+        {
+            Data = Geometry.Parse("M1,11.4 L11,11.4"),
+            Stroke = brush,
+            StrokeThickness = 1,
+            Opacity = .6
+        };
+        canvas.Children.Add(bowl);
+        canvas.Children.Add(rice);
+        canvas.Children.Add(baseLine);
+        return canvas;
+    }
+
+    private VitalsGauge AddGauge(Panel host, FrameworkElement icon, Color color)
+    {
+        const double trackWidth = 30;
+        var fill = new Rectangle
+        {
+            Width = trackWidth,
+            Height = 5,
+            RadiusX = 2.5,
+            RadiusY = 2.5,
+            Fill = new SolidColorBrush(color),
+            HorizontalAlignment = HorizontalAlignment.Left
+        };
+        var track = new Border
+        {
+            Width = trackWidth,
+            Height = 5,
+            CornerRadius = new CornerRadius(2.5),
+            Background = new SolidColorBrush(Color.FromArgb(46, 40, 48, 60)),
+            VerticalAlignment = VerticalAlignment.Center,
+            Child = new Grid { Children = { fill } }
+        };
+        var row = new StackPanel
+        {
+            Orientation = Orientation.Horizontal,
+            Margin = new Thickness(0, 1, 0, 1)
+        };
+        row.Children.Add(icon);
+        row.Children.Add(new Border { Width = 3 });
+        row.Children.Add(track);
+
+        var scale = new ScaleTransform(1, 1);
+        row.RenderTransformOrigin = new Point(0, .5);
+        row.RenderTransform = scale;
+
+        var frame = new Border
+        {
+            CornerRadius = new CornerRadius(8),
+            Background = new SolidColorBrush(Color.FromArgb(214, 255, 252, 246)),
+            BorderBrush = new SolidColorBrush(Color.FromArgb(38, 80, 96, 152)),
+            BorderThickness = new Thickness(1),
+            Padding = new Thickness(4, 3, 5, 3),
+            Margin = new Thickness(0, 0, 0, 2),
+            Child = row,
+            Opacity = .92
+        };
+        var shadow = new System.Windows.Media.Effects.DropShadowEffect
+        {
+            Color = global::BigBlueFish.Windows.CompanionBubble.HairBlue,
+            BlurRadius = 6,
+            ShadowDepth = 1,
+            Opacity = .14
+        };
+        frame.Effect = shadow;
+        host.Children.Add(frame);
+
+        return new VitalsGauge
+        {
+            Row = frame,
+            Fill = fill,
+            Icon = icon,
+            Scale = scale,
+            TrackWidth = trackWidth
+        };
+    }
+
+    // 每帧调用（40ms）。数值平滑靠近目标，低值脉动，涨的时候闪一下。
+    private void UpdateVitalsHud(DateTime now)
+    {
+        if (vitalsHud == null || gauges[0] == null) return;
+        var phase = (now - vitalsHudBuilt).TotalSeconds;
+        var pulse = .55 + .45 * (0.5 + 0.5 * Math.Sin(phase * 4.2));
+
+        UpdateGauge(gauges[0], preferences.Affection, now, phase, pulse);
+        UpdateGauge(gauges[1], preferences.Satiety, now, phase, pulse);
+        UpdateGauge(gauges[2], preferences.Energy, now, phase, pulse);
+    }
+
+    private static void UpdateGauge(VitalsGauge gauge, double value, DateTime now, double phase, double pulse)
+    {
+        gauge.Target = Math.Clamp(value, 0, 100);
+        // 平滑：每帧靠近 12%，避免喂食后数字一下跳过去。
+        gauge.Shown += (gauge.Target - gauge.Shown) * .12;
+        if (Math.Abs(gauge.Target - gauge.Shown) < .2) gauge.Shown = gauge.Target;
+        gauge.Fill.Width = Math.Max(1.5, gauge.TrackWidth * gauge.Shown / 100);
+
+        bool flashing = now < gauge.FlashUntil;
+        if (flashing)
+        {
+            var k = 1 + .18 * Math.Sin((gauge.FlashUntil - now).TotalSeconds * 12);
+            gauge.Scale.ScaleX = gauge.Scale.ScaleY = k;
+            gauge.Row.Opacity = 1;
+        }
+        else if (gauge.Target < 25)
+        {
+            // 低了才动：轻轻呼吸，提醒主人该管管了，但不至于烦。
+            gauge.Scale.ScaleX = gauge.Scale.ScaleY = 1;
+            gauge.Row.Opacity = pulse;
+        }
+        else
+        {
+            gauge.Scale.ScaleX = gauge.Scale.ScaleY = 1;
+            gauge.Row.Opacity = .92;
+        }
+    }
+
+    private void FlashGauge(int index)
+    {
+        if (index < 0 || index >= gauges.Length || gauges[index] == null) return;
+        gauges[index].FlashUntil = DateTime.UtcNow.AddSeconds(1.6);
+    }
+
+    private void FlashAllGauges()
+    {
+        for (int i = 0; i < gauges.Length; i++) FlashGauge(i);
+    }
+}
