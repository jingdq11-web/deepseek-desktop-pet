+    // —————————————— 自播动作池 ——————————————
+    //
+    // 原版只有 Pool=Event 的 91 个动作会被自动播：点击反馈 5 个、拖拽 1 个永远只在你
+    // 动手时出现；再加上「只有夜里 / 只有某个季节 / 只有节日前后 / 只在整点前后」这些
+    // 约束会把权重压成 0，实际一天能看到的就更少。
+    // 现在改成「除已停用和拖拽之外，全部都能自己播」：
+    //   · 被时间/季节/节日约束掉的动作给一个保底权重，偶尔出现而不是永远不出现
+    //   · 点击反馈、待机、请安/刷牙这些按池子降权，不会喧宾夺主
+    //   · 最近 8 个播过的降权，避免老是那几下
+    private const double AutoFloorWeight = 25;
+    private const int AutoRecentMemory = 8;
+    private readonly Queue<string> recentAutoActions = new();
+    private string lastAutoActionId = "";
+
+    private CompanionAnimationRule ChooseAutoAction(CompanionAnimationContext context)
+    {
+        if (!preferences.AutoPlayAllActions)
+            return animationPolicy.Choose("Event", context, companionRandom);
+
+        var candidates = animationPolicy.Rules
+            .Where(r => r.Pool != "Disabled" && r.Pool != "Drag")
+            .Select(r => (Rule: r, Weight: AutoWeight(r, context)))
+            .Where(x => x.Weight > 0)
+            .ToArray();
+        if (candidates.Length == 0)
+            return animationPolicy.Choose("Event", context, companionRandom);
+
+        var point = companionRandom.NextDouble() * candidates.Sum(x => x.Weight);
+        var picked = candidates[^1].Rule;
+        foreach (var entry in candidates)
+        {
+            point -= entry.Weight;
+            if (point < 0) { picked = entry.Rule; break; }
+        }
+        lastAutoActionId = picked.Id;
+        recentAutoActions.Enqueue(picked.Id);
+        while (recentAutoActions.Count > AutoRecentMemory) recentAutoActions.Dequeue();
+        return picked;
+    }
+
+    private double AutoWeight(CompanionAnimationRule rule, CompanionAnimationContext context)
+    {
+        var raw = animationPolicy.Weight(rule, context);
+        // 作者在 animations.json 里给的权重跨度是 0~1000（50 倍），直接拿去做轮盘，
+        // 权重 20/30 的动作几乎永远抽不到（0.2% 意味着几小时才轮到一次）。
+        // 这里压成 0.35 次方，跨度收敛到 4~5 倍：常见动作还是更常见，但没有动作会被饿死。
+        var weight = Math.Pow(raw > 0 ? raw : AutoFloorWeight, .35) * 15;
+        weight *= rule.Pool switch
+        {
+            "Click" => .60,                                          // 点击反馈也会自己播，比正常动作少一半
+            "Idle" => .60,
+            "Greeting" or "Daily" => .30,                            // 请安/刷牙有专门时机，别乱插
+            _ => 1.0
+        };
+        if (rule.Id == lastAutoActionId) weight *= .05;              // 别连着播同一个
+        else if (recentAutoActions.Contains(rule.Id)) weight *= .30; // 最近播过的降权
+        return weight;
+    }
