+++ b/code/BigBlueFish.Windows/Companion/CompanionHousekeeping.cs
@@ -0,0 +1,65 @@
+using System;
+using System.Globalization;
+using System.IO;
+
+namespace BigBlueFish.Windows;
+
+// 目录保洁：错误日志滚一份、非测试模式清掉上次留下的诊断文件。
+//
+// 为什么要做：她每次说话都会把当前窗口截一张图写进 vision-input.jpg（36 KB，
+// 内容是主人的屏幕）。磁盘占用不大，但那是屏幕截图，不该长期躺在安装目录里。
+// 另外错误日志是追加写的，不滚的话遇到循环报错能把磁盘写满。
+internal static class CompanionHousekeeping
+{
+    internal const long ErrorLogLimit = 512 * 1024;
+
+    private static readonly string[] Diagnostics =
+    {
+        "vision-input.jpg",
+        "vision-status.json",
+        "ocr-status.json",
+        "model-request.json",
+        "test-status.json",
+        "test-command.txt"
+    };
+
+    // 返回一句人话，方便写日志/气泡；没有可清的就返回空串。
+    internal static string Run(bool testMode)
+    {
+        bool rotated = RotateErrorLog();
+        int removedDiagnostics = testMode ? 0 : ClearDiagnostics();
+
+        var parts = new System.Collections.Generic.List<string>();
+        if (rotated) parts.Add("错误日志已滚动");
+        if (removedDiagnostics > 0) parts.Add($"清掉 {removedDiagnostics} 个诊断文件");
+        return string.Join("，", parts);
+    }
+
+    private static bool RotateErrorLog()
+    {
+        try
+        {
+            var log = new FileInfo("companion-errors.log");
+            if (!log.Exists || log.Length <= ErrorLogLimit) return false;
+            File.Copy("companion-errors.log", "companion-errors.log.old", true);
+            File.WriteAllText("companion-errors.log", "");
+            return true;
+        }
+        catch { return false; }
+    }
+
+    private static int ClearDiagnostics()
+    {
+        int removed = 0;
+        foreach (var name in Diagnostics)
+            try
+            {
+                if (!File.Exists(name)) continue;
+                File.Delete(name);
+                removed++;
+            }
+            catch { }
+        return removed;
+    }
+
+}
