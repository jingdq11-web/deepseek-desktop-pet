diff -urN a/code/BigBlueFish.Windows/Companion/CompanionVitals.cs b/code/BigBlueFish.Windows/Companion/CompanionVitals.cs
--- /dev/null
+++ b/code/BigBlueFish.Windows/Companion/CompanionVitals.cs
@@ -0,0 +1,309 @@
+using System;
+using System.Collections.Generic;
+using System.Globalization;
+using System.Linq;
+
+namespace BigBlueFish.Windows;
+
+// 养成数值：好感度 / 饱食度 / 精力。
+// 掉太快会烦人，涨太容易又没意思，所以按小时给一个温和的斜率，
+// 离线太久最多补算 12 小时，免得隔三天回来发现她已经饿死了。
+public partial class MainWindow
+{
+    // 投喂一次只加 2.5：饱食 50 → 100 正好要喂 20 次，让「喂她」变成一个长期的日常动作，
+    // 而不是两下就喂满。既然涨得慢，衰减也必须同步调慢（原来 4/时），否则永远补不回来。
+    private const double FeedSatietyGain = 2.5;
+    private const double SatietyPerHour = 1.5;
+    private const double EnergyPerHourAwake = 5.0;
+    private const double EnergyPerHourAsleep = 8.0;
+    private const double AffectionDriftPerHour = 0.25;
+    private const double AffectionNeglectPerHour = 1.2;
+    private const double MaxOfflineHours = 12;
+    // 饿到多少她才开口讨吃。投喂一次只加 2.5，卡在 30 的话她一天都不一定会说话，所以放宽到 50。
+    private const double HungerAskBelow = 50;
+    private const double HungerUrgentBelow = 25;
+
+    private bool vitalsLoaded;
+    private DateTime vitalsNextSave = DateTime.MinValue;
+    private DateTime vitalsNextNotice = DateTime.MinValue;
+    private DateTime hungerAskNext = DateTime.MinValue;
+    private DateTime sleepyAskNext = DateTime.MinValue;
+    private DateTime clingNext = DateTime.MinValue;
+
+    private void LoadVitals()
+    {
+        if (vitalsLoaded) return;
+        vitalsLoaded = true;
+        var now = DateTime.Now;
+        if (DateTime.TryParse(preferences.VitalsStamp, CultureInfo.InvariantCulture,
+                DateTimeStyles.RoundtripKind, out var stamp))
+            ApplyVitalsDecay(stamp, now);
+        preferences.VitalsStamp = now.ToString("O", CultureInfo.InvariantCulture);
+    }
+
+    // 每次 tick 只做「到点补算」，真正写盘两分钟一次，别把 preferences.json 写烂。
+    private void VitalsTick()
+    {
+        LoadVitals();
+        brain.Affection = preferences.Affection;
+        var now = DateTime.Now;
+        if (DateTime.TryParse(preferences.VitalsStamp, CultureInfo.InvariantCulture,
+                DateTimeStyles.RoundtripKind, out var stamp) && (now - stamp).TotalSeconds >= 30)
+        {
+            ApplyVitalsDecay(stamp, now);
+            preferences.VitalsStamp = now.ToString("O", CultureInfo.InvariantCulture);
+        }
+        else if (!DateTime.TryParse(preferences.VitalsStamp, CultureInfo.InvariantCulture,
+                DateTimeStyles.RoundtripKind, out _))
+        {
+            preferences.VitalsStamp = now.ToString("O", CultureInfo.InvariantCulture);
+        }
+        if (now >= vitalsNextSave)
+        {
+            vitalsNextSave = now.AddMinutes(2);
+            SaveCompanion();
+        }
+        VitalsSocialTick(now);
+    }
+
+    // 数值驱动她「主动来找你」：饿了讨吃的、困了想睡、太亲了黏人。
+    private void VitalsSocialTick(DateTime now)
+    {
+        if (!companionReady || companionClosed || PuppetActive) return;
+        if (hiddenByUser || fullscreenHidden || companionSettings != null) return;
+        if (speechRequestPending || brain.Busy) return;
+
+        // 饿了：主动讨投喂，越饿越勤（45 分钟 → 20 分钟）。深夜不吵主人。
+        if (preferences.Satiety < HungerAskBelow && now >= hungerAskNext && now.Hour is >= 8 and < 23)
+        {
+            hungerAskNext = now.AddMinutes(preferences.Satiety < HungerUrgentBelow ? 20 : 45);
+            FlashGauge(1);
+            var rule = animationPolicy?.Rules.FirstOrDefault(r => r.Pool != "Disabled" && r.Meal != null);
+            if (rule != null) { mcpActions.Clear(); CancelMovement(); PlayAnimation(rule, "Event"); }
+            ShowCompanionNotice(preferences.Satiety < HungerUrgentBelow
+                ? "主人…鱼鱼饿得有点晕了，真的不能吃一口吗…"
+                : "唔…主人，鱼鱼肚子在叫了，能不能喂鱼鱼一点吃的呀");
+            return;
+        }
+
+        // 困了：白天会念叨一句，深夜就自己睡（不打扰）。
+        if (preferences.Energy < 22 && now >= sleepyAskNext)
+        {
+            sleepyAskNext = now.AddMinutes(35);
+            FlashGauge(2);
+            if (now.Hour is >= 8 and < 23)
+            {
+                var rule = animationPolicy?.Rules.FirstOrDefault(r => r.Pool != "Disabled" && r.Id.Contains("哈欠"));
+                if (rule != null) { mcpActions.Clear(); CancelMovement(); PlayAnimation(rule, "Event"); }
+                ShowCompanionNotice("主人…鱼鱼眼睛睁不开了，可以靠着主人眯一小会儿吗…");
+            }
+            return;
+        }
+
+        // 很亲的时候：主动凑过来说话（频率已由 NextSpeechDelay 提高，这里只补一个主动贴贴）。
+        if (preferences.Affection >= 85 && now >= clingNext && companionRandom.NextDouble() < .5)
+        {
+            clingNext = now.AddMinutes(40);
+            var rule = FindAnimation("撒娇", "蹭", "抱", "开心", "跃动");
+            if (rule != null) { mcpActions.Clear(); CancelMovement(); PlayAnimation(rule, "Event"); }
+            ShowCompanionNotice("主人～鱼鱼就在旁边哦，有事叫鱼鱼");
+        }
+    }
+
+    private void ApplyVitalsDecay(DateTime from, DateTime to)
+    {
+        if (to <= from) return;
+        var hours = Math.Min((to - from).TotalHours, MaxOfflineHours);
+        double satietyLoss = 0, energyGain = 0;
+        var step = TimeSpan.FromMinutes(15);
+        var cursor = from;
+        var consumed = 0.0;
+        while (consumed < hours)
+        {
+            var slice = Math.Min(step.TotalHours, hours - consumed);
+            bool asleep = cursor.Hour >= 23 || cursor.Hour < 8;
+            satietyLoss += SatietyPerHour * slice;
+            energyGain += (asleep ? EnergyPerHourAsleep : -EnergyPerHourAwake) * slice;
+            consumed += slice;
+            cursor = cursor.AddHours(slice);
+        }
+        preferences.Satiety = Math.Clamp(preferences.Satiety - satietyLoss, 0, 100);
+        preferences.Energy = Math.Clamp(preferences.Energy + energyGain, 0, 100);
+        bool neglected = preferences.Satiety < 20 || preferences.Energy < 20;
+        preferences.Affection = Math.Clamp(preferences.Affection
+            - (neglected ? AffectionNeglectPerHour : AffectionDriftPerHour) * hours, 0, 100);
+    }
+
+    private CompanionAnimationRule? FindAnimation(params string[] keywords) =>
+        animationPolicy?.Rules.FirstOrDefault(r => r.Pool != "Disabled"
+            && keywords.Any(k => r.Id.Contains(k, StringComparison.Ordinal)));
+
+    // 数值低到一定程度时，动画边界会优先播对应的动作，而不是继续随机。
+    private bool TryVitalsAnimation()
+    {
+        if (!companionReady || companionClosed || animationPolicy == null) return false;
+        if (preferences.Energy < 18 && companionRandom.NextDouble() < .55)
+        {
+            var rule = FindAnimation("打瞌睡", "小憩", "沉眠", "哈欠", "发呆");
+            if (rule != null)
+            {
+                PlayAnimation(rule, "Event");
+                VitalsNotice("主人…鱼鱼好困，眼睛要合上了…");
+                return true;
+            }
+        }
+        if (preferences.Satiety < 22 && companionRandom.NextDouble() < .55)
+        {
+            var rule = animationPolicy.Rules.FirstOrDefault(r => r.Pool != "Disabled" && r.Meal != null);
+            if (rule != null)
+            {
+                PlayAnimation(rule, "Event");
+                VitalsNotice("主人，鱼鱼肚子咕咕叫了…");
+                return true;
+            }
+        }
+        if (preferences.Affection > 80 && companionRandom.NextDouble() < .2)
+        {
+            var rule = FindAnimation("撒娇", "开心", "跃动", "哼歌", "伸懒腰");
+            if (rule != null) { PlayAnimation(rule, "Event"); return true; }
+        }
+        return false;
+    }
+
+    private void VitalsNotice(string text)
+    {
+        var now = DateTime.Now;
+        if (now < vitalsNextNotice) return;
+        vitalsNextNotice = now.AddMinutes(10);
+        ShowCompanionNotice(text);
+    }
+
+    // 喂她吃东西：饱食度小涨（一次 2.5，50→100 要 20 次），好感度小涨，顺手播一个吃饭动作。
+    private void FeedCompanion()
+    {
+        if (companionClosed || !companionReady) return;
+        if (hiddenByUser) RestoreCompanion();
+        ApplyMealVitals();
+        var rule = PickMealAction();
+        if (rule != null && !PuppetActive)
+        {
+            mcpActions.Clear();
+            CancelMovement();
+            PlayAnimation(rule, "External");
+        }
+        var text = preferences.Satiety >= 90
+            ? "呜…吃太饱了，鱼鱼要躺平一会儿～"
+            : preferences.Satiety >= 50
+                ? "谢谢主人！鱼鱼吃得饱饱的～"
+                : "还有吗还有吗？鱼鱼还没吃饱…";
+        vitalsNextNotice = DateTime.Now.AddMinutes(3);
+        ShowCompanionNotice(text);
+    }
+
+    // 数值部分单独抽出来：从右键「吃点什么」直接点某道菜时，动作播你点的那一个，
+    // 数值也照投喂算 —— 不然会出现「明明看她吃了，饱食一点没涨」的怪事。
+    private void ApplyMealVitals()
+    {
+        preferences.Satiety = Math.Clamp(preferences.Satiety + FeedSatietyGain, 0, 100);
+        preferences.Affection = Math.Clamp(preferences.Affection + TakeFeedAffection(), 0, 100);
+        preferences.Energy = Math.Clamp(preferences.Energy + 2, 0, 100);
+        brain.Affection = preferences.Affection;
+        SaveCompanion();
+        FlashGauge(1);
+        hungerAskNext = DateTime.Now.AddMinutes(40);
+    }
+
+    // 投喂时播哪个吃饭动作：跟右键菜单「吃点什么」那一组完全一致（21 个）。
+    // 原来只挑 animations.json 里 Meal 明确标了早/午/晚餐的 3 个，所以看起来永远是那三下；
+    // 现在整组随机，偶尔也会出现「涮火锅」「吃西瓜」「偷吃零食被抓住」。
+    private CompanionAnimationRule? PickMealAction()
+    {
+        var policy = animationPolicy ?? menuActionPolicy;
+        if (policy == null) return null;
+        var pool = policy.Rules
+            .Where(r => r.Pool != "Disabled" && MenuGroupOf(r) == "吃点什么")
+            .ToArray();
+        return pool.Length == 0 ? null : pool[Random.Shared.Next(pool.Length)];
+    }
+
+    // 摸一摸：点一下就涨一点好感，涨得慢才显得金贵。
+    private void PetCompanion()
+    {
+        preferences.Affection = Math.Clamp(preferences.Affection + 0.5, 0, 100);
+        FlashGauge(0);
+    }
+
+    // —————————————— 互动涨好感 ——————————————
+    //
+    // 光靠摸头太少了，所以她做的每件事都算数：
+    //   · 右键点一个动作        +0.5（同一个动作 10 分钟内重复只 +0.1）
+    //   · 喂她吃一次            +5.0（10 分钟内再喂只 +1.0）
+    //   · 双击找她聊天          +1.0（5 分钟最多一次）
+    //   · 每发一条消息          +0.6（30 秒最多一次）
+    // 递减不是小气：不这么写的话按住一个动作连点就能把好感刷满，数值就没意义了。
+    private const double ActionAffectionGain = 0.5;
+    private const double ActionAffectionRepeat = 0.1;
+    private const double FeedAffectionGain = 5.0;
+    private const double FeedAffectionRepeat = 1.0;
+    private const double ChatOpenAffectionGain = 1.0;
+    private const double ChatMessageAffectionGain = 0.6;
+    private readonly Dictionary<string, DateTime> actionAffectionAt = new();
+    private DateTime chatOpenAffectionAt = DateTime.MinValue;
+    private DateTime chatMessageAffectionAt = DateTime.MinValue;
+
+    private void GrantAffection(double amount)
+    {
+        if (amount <= 0) return;
+        preferences.Affection = Math.Clamp(preferences.Affection + amount, 0, 100);
+        brain.Affection = preferences.Affection;
+        FlashGauge(0);
+        SaveCompanion();
+    }
+
+    // 同一条互动 10 分钟内重复只给零头。返回这次该加多少。
+    private double InteractionGain(string key, double full, double repeat)
+    {
+        var now = DateTime.Now;
+        if (actionAffectionAt.Count > 256) actionAffectionAt.Clear();
+        var gain = actionAffectionAt.TryGetValue(key, out var last) && (now - last).TotalMinutes < 10
+            ? repeat
+            : full;
+        actionAffectionAt[key] = now;
+        return gain;
+    }
+
+    // 点右键菜单里的动作。换个动作才有全额，鼓励把 106 个都玩一遍。
+    private void GrantActionAffection(string id) =>
+        GrantAffection(InteractionGain("action:" + id, ActionAffectionGain, ActionAffectionRepeat));
+
+    // 喂食 / 点某道菜给的好感。
+    private double TakeFeedAffection() =>
+        InteractionGain("feed", FeedAffectionGain, FeedAffectionRepeat);
+
+    // 双击打开聊天输入框。
+    private void GrantChatOpenAffection()
+    {
+        var now = DateTime.Now;
+        if ((now - chatOpenAffectionAt).TotalMinutes < 5) return;
+        chatOpenAffectionAt = now;
+        GrantAffection(ChatOpenAffectionGain);
+    }
+
+    // 发出一条消息。连发不重复计数。
+    private void GrantChatMessageAffection()
+    {
+        var now = DateTime.Now;
+        if ((now - chatMessageAffectionAt).TotalSeconds < 30) return;
+        chatMessageAffectionAt = now;
+        GrantAffection(ChatMessageAffectionGain);
+    }
+
+    internal string VitalsSummary()
+    {
+        var mood = preferences.Affection >= 75 ? "很喜欢主人"
+            : preferences.Affection >= 45 ? "和主人还挺好"
+            : preferences.Affection >= 20 ? "有点想被理一理"
+            : "在闹别扭";
+        return $"好感 {preferences.Affection:0}｜饱食 {preferences.Satiety:0}｜精力 {preferences.Energy:0}（{mood}）";
+    }
+}
