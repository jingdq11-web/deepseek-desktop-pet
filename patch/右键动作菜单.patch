+using System;
+using System.Diagnostics;
+using System.Text;
+
+namespace BigBlueFish.Windows;
+
+// 判断主人现在是不是在写代码 / 办公，用来挑更贴切的动作和语气。
+// 只看进程名，不读窗口内容，不联网，纯本地。
+internal static class CompanionWorkContext
+{
+    private static readonly string[] Coding =
+    {
+        "devenv", "code", "cursor", "windsurf", "trae", "hbuilderx",
+        "rider64", "idea64", "pycharm64", "webstorm64", "clion64", "goland64",
+        "phpstorm64", "datagrip64", "rubymine64", "studio64", "androidstudio",
+        "sublime_text", "notepad++", "notepad", "zed", "nvim", "vim", "emacs", "xcode",
+        "unity", "unityhub", "godot", "blender", "rstudio", "matlab", "jupyter"
+    };
+
+    private static readonly string[] Working =
+    {
+        "winword", "excel", "powerpnt", "onenote", "mspub", "visio", "msaccess",
+        "wps", "et", "wpp", "wpsoffice", "pdf",
+        "acrobat", "acrord32", "foxitreader", "foxitpdfreader", "sumatrapdf",
+        "notion", "obsidian", "typora", "xmind", "mindmaster", "logseq",
+        "figma", "photoshop", "illustrator", "aftereffects", "premiere", "coreldrw",
+        "outlook", "thunderbird", "onenotem"
+    };
+
+    private static IntPtr cachedHandle;
+    private static DateTime cachedAt = DateTime.MinValue;
+    private static (bool Coding, bool Working) cached;
+
+    // 每 2 秒最多查一次进程，避免动画边界频繁枚举进程表。
+    internal static (bool Coding, bool Working) Classify(IntPtr handle)
+    {
+        var now = DateTime.UtcNow;
+        if (handle == cachedHandle && now - cachedAt < TimeSpan.FromSeconds(2)) return cached;
+        cachedHandle = handle;
+        cachedAt = now;
+        cached = Compute(handle);
+        return cached;
+    }
+
+    private static (bool Coding, bool Working) Compute(IntPtr handle)
+    {
+        var name = ProcessName(handle);
+        if (name.Length == 0) return (false, false);
+        if (Array.Exists(Coding, n => name.Equals(n, StringComparison.OrdinalIgnoreCase))) return (true, true);
+        if (Array.Exists(Working, n => name.Equals(n, StringComparison.OrdinalIgnoreCase))) return (false, true);
+        return (false, false);
+    }
+
+    internal static string ProcessName(IntPtr handle)
+    {
+        if (handle == IntPtr.Zero || CompanionNative.IsDesktopWindow(handle)) return "";
+        CompanionNative.GetWindowThreadProcessId(handle, out var pid);
+        if (pid == 0 || pid == Environment.ProcessId) return "";
+        try { using var process = Process.GetProcessById((int)pid); return process.ProcessName; }
+        catch { return ""; }
+    }
+
+    internal static string WindowTitle(IntPtr handle)
+    {
+        if (handle == IntPtr.Zero) return "";
+        var title = new StringBuilder(512);
+        CompanionNative.GetWindowText(handle, title, title.Capacity);
+        return title.ToString().Trim();
+    }
+
+    // 日记里用的简短描述：应用名 + 标题（标题截断，避免写进去一长串无关内容）。
+    internal static string Describe(IntPtr handle)
+    {
+        var name = ProcessName(handle);
+        if (name.Length == 0) return "";
+        var title = WindowTitle(handle);
+        foreach (var suffix in new[] { " - Google Chrome", " - Microsoft\u200b Edge", " - Visual Studio Code" })
+            if (title.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
+                title = title[..^suffix.Length];
+        if (title.Length > 40) title = title[..40] + "…";
+        return title.Length == 0 ? name : name + "｜" + title;
+    }
+}
