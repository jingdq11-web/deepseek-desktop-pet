+
+namespace BigBlueFish.Windows;
+
+// 日常功能：番茄钟、久坐提醒、日记、生日、剪贴板联动、截图取字。
+// 全部只在本机跑，不联网（剪贴板联动走本地模型）。
+public partial class MainWindow
+{
+    private DateTime extrasNextTick = DateTime.MinValue;
+    private bool extrasErrorLogged;
+
+    private DateTime? pomodoroEnd;
+    private int pomodoroMinutes;
+    private DateTime sitSince = DateTime.Now;
+
+
+    private DateTime clipboardNextAt = DateTime.MinValue;
+    private string clipboardLast = "";
+    private bool clipboardBusy;
+    private string housekeepingDate = "";
+
+    // 一秒一次的总闸，所有日常功能都从这里走，避免各自加定时器。
+    private void CompanionExtrasTick()
+    {
+        var now = DateTime.Now;
+        if (now < extrasNextTick) return;
+        extrasNextTick = now.AddSeconds(1);
+        try
+        {
+            VitalsTick();
+            PomodoroTick(now);
+            SitTick(now);
+            BirthdayTick(now);
+            HousekeepingTick(now);
+        }
+        catch (Exception e)
+        {
+            if (extrasErrorLogged) return;
+            extrasErrorLogged = true;
+            try { File.WriteAllText("companion-extras-errors.log", e.ToString()); } catch { }
+        }
+    }
+
+    // —————————————— 目录保洁 ——————————————
+
+    // 一天跑一次就够：删过期日记、滚动错误日志、清诊断文件。
+    private void HousekeepingTick(DateTime now)
+    {
+        var today = now.ToString("yyyy-MM-dd");
+        if (housekeepingDate == today) return;
+        housekeepingDate = today;
+        var summary = CompanionHousekeeping.Run(TestMode);
+        if (summary.Length > 0)
+        {
+            try { File.AppendAllText("companion-errors.log", $"{now:s} 保洁：{summary}{Environment.NewLine}"); } catch { }
+        }
+    }
+
+    // —————————————— 番茄钟 ——————————————
+
+    internal bool PomodoroRunning => pomodoroEnd != null;
+
+    internal string PomodoroLabel()
+    {
+        if (pomodoroEnd is not { } end) return "番茄钟";
+        var left = end - DateTime.Now;
+        return left <= TimeSpan.Zero ? "番茄钟（马上到）" : $"番茄钟（还剩 {(int)left.TotalMinutes + 1} 分钟）";
+    }
+
+    private void StartPomodoro(int minutes)
+    {
+        pomodoroMinutes = minutes;
+        pomodoroEnd = DateTime.Now.AddMinutes(minutes);
+        if (hiddenByUser) RestoreCompanion();
+        ShowCompanionNotice($"好！鱼鱼帮主人看着时间，{minutes} 分钟后叫你～先专心做事哦");
+    }
+
+    private void StopPomodoro()
+    {
+        if (pomodoroEnd == null) return;
+        pomodoroEnd = null;
+        ShowCompanionNotice("计时停啦，那……下次再一起加油？");
+    }
+
+    private void PomodoroTick(DateTime now)
+    {
+        if (pomodoroEnd is not { } end || now < end) return;
+        pomodoroEnd = null;
+        if (!companionReady || companionClosed) return;
+        var rule = FindAnimation("雀跃", "庆祝", "开心", "跃动", "伸懒腰");
+        if (rule != null && !PuppetActive)
+        {
+            mcpActions.Clear();
+            CancelMovement();
+            PlayAnimation(rule, "External");
+        }
+        ShowCompanionNotice($"主人，{pomodoroMinutes} 分钟到啦！站起来动一动，顺便喝口水～");
+    }
+
+    // —————————————— 久坐提醒 ——————————————
+
+    private void SitTick(DateTime now)
+    {
+        // 离开电脑两分钟以上就重新计时，不然一天下来会被提醒到烦。
+        if (CompanionNative.IdleSeconds > 120) { sitSince = now; return; }
+        if ((now - sitSince).TotalMinutes < preferences.SitLimitMinutes) return;
+        sitSince = now;
+        if (!companionReady || companionClosed || PuppetActive) return;
+        var rule = FindAnimation("伸懒腰", "哈欠", "散步", "原地漂浮");
+        if (rule != null)
+        {
+            mcpActions.Clear();
+            CancelMovement();
+            PlayAnimation(rule, "External");
+        }
+        ShowCompanionNotice($"主人已经连着坐了 {preferences.SitLimitMinutes} 分钟了，跟鱼鱼一起站起来伸个懒腰吧？");
+    }
+
+    // —————————————— 生日 ——————————————
+
+    private void BirthdayTick(DateTime now)
+    {
+        if (preferences.BirthdayMonth <= 0 || preferences.BirthdayDay <= 0) return;
+        if (now.Month != preferences.BirthdayMonth || now.Day != preferences.BirthdayDay) return;
+        if (preferences.LastBirthdayYear == now.Year) return;
+        preferences.LastBirthdayYear = now.Year;
+        SaveCompanion();
+        if (!companionReady || companionClosed) return;
+        var rule = FindAnimation("红包", "烟花", "庆祝", "雀跃", "孔明灯", "生日快乐");
+        if (rule != null && !PuppetActive)
+        {
+            mcpActions.Clear();
+            CancelMovement();
+            PlayAnimation(rule, "External");
+        }
+        ShowCompanionNotice("主人！生日快乐！！鱼鱼一直记得今天的～祝主人今年顺顺利利，想要什么都能拿到！");
+    }
+
+    // —————————————— 剪贴板联动 ——————————————
+
+    private void OnClipboardChanged()
+    {
+        if (!preferences.ClipboardWatch || clipboardBusy) return;
+        if (!companionReady || companionClosed || PuppetActive) return;
+        if (hiddenByUser || fullscreenHidden || companionSettings != null || modelInstaller != null) return;
+        if (DateTime.Now < clipboardNextAt) return;
+        string text;
+        try
+        {
+            if (!Clipboard.ContainsText()) return;
+            text = Clipboard.GetText().Trim();
+        }
+        catch { return; }
+        if (text.Length < 8 || text == clipboardLast) return;
+        clipboardLast = text;
+        var kind = CompanionClipboard.Classify(text);
+        if (kind == CompanionClipboardKind.None) return;
+        clipboardNextAt = DateTime.Now.AddSeconds(25);
+        _ = ClipboardReactAsync(kind, text);
+    }
+
+    private async Task ClipboardReactAsync(CompanionClipboardKind kind, string text)
+    {
+        if (clipboardBusy || brain.Busy || !preferences.ModelEnabled || !brain.ModelAvailable || !brain.CanRunOnCurrentPower) return;
+        clipboardBusy = true;
+        var snippet = text.Length > 1200 ? text[..1200] : text;
+        try
+        {
+            var (persona, request) = kind switch
+            {
+                CompanionClipboardKind.Code =>
+                    (CompanionDialogue.ClipboardCodePersona, "主人刚复制的代码：\n" + snippet),
+                CompanionClipboardKind.Link =>
+                    (CompanionDialogue.ClipboardLinkPersona, "主人刚复制的链接：\n" + snippet),
+                _ =>
+                    (CompanionDialogue.ClipboardTranslatePersona, "主人刚复制的外文：\n" + snippet)
+            };
+            BeginModelSpeech();
+            var reply = await brain.GenerateCustom(persona, request, .6);
+            if (reply.Length > 0 && !companionClosed && !hiddenByUser) ShowCompanionBubble(reply);
+        }
+        catch { }
+        finally
+        {
+            EndModelSpeech();
+            clipboardBusy = false;
+        }
+    }
+
+    // —————————————— 看屏幕汇报 ——————————————
+
+    // 她要做的不是抄字，是「看懂主人在干什么，再说一句自己的感想」。
+    private async Task ReportScreenAsync()
+    {
+        if (PuppetActive) return;
+        var handle = CompanionNative.ResolveSpeechForeground(
+            CompanionNative.GetForegroundWindow(), lastExternalForeground);
+        if (handle == IntPtr.Zero)
+        {
+            ShowCompanionNotice("主人先打开一个窗口，鱼鱼才看得到呀～");
+            return;
+        }
+        if (!preferences.ModelEnabled || !brain.ModelAvailable)
+        {
+            ShowCompanionNotice("鱼鱼的脑子还没准备好，等一会儿再看看？");
+            return;
+        }
+        if (hiddenByUser) RestoreCompanion();
+        ShowCompanionNotice("鱼鱼看看主人在忙什么…");
+        string report;
+#if COMPANION_OCR
+        try
+        {
+            var snapshot = await CompanionOcr.ReadAsync(handle, CancellationToken.None);
+            var text = CompanionOcrLayout.Format(snapshot.Words, snapshot.Width, snapshot.Height);
+            report = await brain.GenerateScreenReportAsync(null, text);
+        }
+        catch (Exception)
+        {
+            report = "";
+        }
+#else
+        var image = CompanionNative.ForegroundWindowImage(handle);
+        if (image == null)
+        {
+            ShowCompanionNotice("这个窗口鱼鱼看不到，换一个再试试？");
+            return;
+        }
+        report = await brain.GenerateScreenReportAsync(image, null);
+#endif
+        if (string.IsNullOrWhiteSpace(report))
+        {
+            ShowCompanionNotice("唔…鱼鱼没看明白，再试一次？");
+            return;
+        }
+        // 汇报比平时一句话长，气泡留久一点，够主人读完。
+        ShowCompanionBubble(report, 40);
+    }
+}
+
+internal enum CompanionClipboardKind { None, Code, Link, Foreign }
+
+// 剪贴板内容分类。宁可少触发，也不要让群里那种复制粘贴把它当复读机。
+internal static class CompanionClipboard
+{
+    private static readonly string[] CodeHints =
+    {
+        "function ", "def ", "class ", "import ", "public ", "private ", "const ", "let ",
+        "return ", "#include", "<?php", "</", "=>", "();", "}\n", "#!/", "SELECT ", "from "
+    };
+
+    internal static CompanionClipboardKind Classify(string text)
+    {
+        var trimmed = text.Trim();
+        if (trimmed.Length == 0) return CompanionClipboardKind.None;
+
+        bool looksLikeUrl = trimmed.Length <= 400
+            && (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
+                || trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
+            && !trimmed.Contains('\n');
+        if (looksLikeUrl) return CompanionClipboardKind.Link;
+
+        bool hasBraces = trimmed.Contains('{') && trimmed.Contains('}');
+        bool hasHint = CodeHints.Any(h => trimmed.Contains(h, StringComparison.Ordinal));
+        if (trimmed.Contains("```") || (hasBraces && hasHint) || (hasHint && trimmed.Contains(";\n")))
+            return CompanionClipboardKind.Code;
+
+        int latin = 0, cjk = 0;
+        foreach (var c in trimmed)
+        {
+            if (c is >= 'a' and <= 'z' or >= 'A' and <= 'Z') latin++;
+            else if (c is >= '\u4E00' and <= '\u9FFF') cjk++;
+        }
+        if (latin >= 20 && cjk == 0 && latin > trimmed.Length * 0.5) return CompanionClipboardKind.Foreign;
+
+        return CompanionClipboardKind.None;
+    }
+}
