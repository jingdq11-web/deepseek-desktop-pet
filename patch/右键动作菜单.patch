+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+
+namespace BigBlueFish.Windows;
+
+// 右键菜单扩展：让她做点事。
+//
+// 分组策略：先看 animations.json 里的官方元数据（Meal / Festival / WorkKind / Pool），
+// 这些是作者亲手标的，最准；剩下没标的再按动作名的关键词归堆。
+// 所以作者以后加新动作，只要文件名语义正常，就会自动落进合适的组，
+// 万一哪个都不匹配，也只是掉进「其他动作」，不会丢。
+public partial class MainWindow
+{
+    // 菜单在构造期就要建好，那时 animationPolicy 还没加载，所以这里单独持有一份。
+    private CompanionAnimationPolicy? menuActionPolicy;
+
+    // 关键词兜底：从上往下，第一个命中的算数。顺序有意义（"偷吃零食"要先被"吃"抓住）。
+    private static readonly (string Name, string[] Keywords)[] KeywordGroups =
+    {
+        ("吃点什么", new[] { "吃" }),
+        ("过节", new[] { "孔明灯", "河灯", "茱萸", "雪人", "福字", "红包", "烟花", "赏月", "月饼", "元宵", "粽子", "年糕", "腊八", "重阳", "七夕", "圣诞", "南瓜灯" }),
+        ("干活", new[] { "工作状态", "碎碎念", "记录", "写代码", "思考" }),
+        ("才艺", new[] { "舞", "小提琴", "笛", "魔术", "魔方", "五子棋", "扑克", "演奏", "抛接" }),
+        ("玩耍", new[] { "玩", "水枪", "风筝", "秋千", "陀螺", "毽子", "木马", "气球", "拆礼物", "摇扇", "撸猫", "照镜子", "散步", "漂浮", "敲击", "跳跃", "奔跑" }),
+        ("特效", new[] { "鲸鱼", "蓝鲸", "泡泡", "生花", "鸽子", "环绕", "蝴蝶", "落叶", "螃蟹", "重力", "360", "换装", "开花", "旋转" }),
+        ("卖萌与日常", new[] { "哈欠", "伸懒腰", "幽灵", "吓", "东张西望", "呼吸", "哼歌", "小憩", "打瞌睡", "沉眠", "待机", "发呆", "可爱", "礼仪", "刷牙" }),
+    };
+
+    private static string MenuGroupOf(CompanionAnimationRule rule)
+    {
+        if (rule.Pool == "Disabled") return "已停用";
+        if (rule.Meal != null) return "吃点什么";
+        if (rule.Festival != null) return "过节";
+        if (rule.WorkKind != null) return "干活";
+        if (rule.Pool is "Click" or "Drag") return "互动反馈";
+        foreach (var group in KeywordGroups)
+            if (group.Keywords.Any(k => rule.Id.Contains(k, StringComparison.Ordinal)))
+                return group.Name;
+        return "其他动作";
+    }
+
+    private void AppendActionMenu(ContextMenu menu)
+    {
+        CompanionAnimationPolicy policy;
+        try
+        {
+            // 构造阶段 animationPolicy 为 null，自己读一次；读不到就安静地不挂这个菜单，
+            // 不能因为一个扩展菜单把整个桌宠搞挂。
+            policy = animationPolicy ?? CompanionAnimationPolicy.Load(AnimationDirectory);
+        }
+        catch (Exception)
+        {
+            return;
+        }
+
+        menuActionPolicy = policy;
+
+        // 子菜单项住在 Popup 里，隐式样式不一定能继承过去，显式套一遍最保险。
+        var itemStyle = menu.TryFindResource(typeof(MenuItem)) as Style;
+        MenuItem NewItem(string header)
+        {
+            var item = new MenuItem { Header = header };
+            if (itemStyle != null) item.Style = itemStyle;
+            return item;
+        }
+
+        var root = NewItem("让她做点事");
+        root.Icon = MenuGlyph("\uE768");
+
+        var random = NewItem("随便来一个");
+        random.Click += (_, _) =>
+        {
+            menu.IsOpen = false;
+            PlayActionFromMenu(PickRandomAction());
+        };
+        root.Items.Add(random);
+        root.Items.Add(new Separator());
+
+        // 按固定顺序出组，保证每次右键位置稳定，肌肉记忆不会乱。
+        string[] order = { "吃点什么", "过节", "干活", "才艺", "玩耍", "特效", "卖萌与日常", "互动反馈", "其他动作", "已停用" };
+        var buckets = new Dictionary<string, List<CompanionAnimationRule>>();
+        foreach (var rule in policy.Rules)
+        {
+            var key = MenuGroupOf(rule);
+            if (!buckets.TryGetValue(key, out var list)) buckets[key] = list = new();
+            list.Add(rule);
+        }
+
+        foreach (var name in order)
+        {
+            if (!buckets.TryGetValue(name, out var rules) || rules.Count == 0) continue;
+            var disabled = name == "已停用";
+            var sub = NewItem(name + "（" + rules.Count + "）");
+            foreach (var rule in rules)
+            {
+                var id = rule.Id;
+                var item = NewItem(id);
+                if (disabled) item.IsEnabled = false;
+                item.Click += (_, _) =>
+                {
+                    menu.IsOpen = false;
+                    PlayActionFromMenu(id);
+                };
+                sub.Items.Add(item);
+            }
+            root.Items.Add(sub);
+        }
+
+        menu.Items.Add(new Separator());
+        menu.Items.Add(root);
+
+        menu.Opened += (_, _) => root.IsEnabled = companionReady && !companionClosed;
+    }
+
+    private string PickRandomAction()
+    {
+        var policy = menuActionPolicy;
+        if (policy == null) return "待机呼吸休闲";
+        var pool = policy.Rules.Where(r => r.Pool != "Disabled").ToList();
+        if (pool.Count == 0) return "待机呼吸休闲";
+        return pool[Random.Shared.Next(pool.Count)].Id;
+    }
+
+    // 和 MCP 的 interrupt_action 走同一条路：清空待播队列、取消移动安排，立刻播。
+    private void PlayActionFromMenu(string id)
+    {
+        if (!companionReady || companionClosed) return;
+        var rule = (animationPolicy ?? menuActionPolicy)?.Rules.FirstOrDefault(r => r.Id == id);
+        if (rule == null) return;
+        if (hiddenByUser) RestoreCompanion();
+        if (PuppetActive)
+        {
+            ShowCompanionNotice("主人，现在是提线木偶模式，动作由外部接管啦～");
+            return;
+        }
+        mcpActions.Clear();
+        CancelMovement();
+        PlayAnimation(rule, "External");
+        // 从「吃点什么」里点某道菜 = 她真的吃下去了：动作播你点的那一个，数值照投喂算。
+        if (MenuGroupOf(rule) == "吃点什么") ApplyMealVitals();
+        else GrantActionAffection(rule.Id);
+    }
+
+    private static TextBlock MenuGlyph(string glyph) => new()
+    {
+        Text = glyph,
+        FontFamily = new FontFamily("Segoe MDL2 Assets"),
+        FontSize = 16,
+        Foreground = new SolidColorBrush(Color.FromRgb(80, 96, 152)),
+        VerticalAlignment = VerticalAlignment.Center
+    };
+}
